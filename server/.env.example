PORT=5000
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
ADMIN_JWT_SECRET=your_admin_jwt_secret_change_this
ADMIN_JWT_EXPIRE=1d

# Twilio WhatsApp OTP (no DLT required)
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+14155238886

# Admin credentials (initial setup)
ADMIN_EMAIL=admin@niotea.com
ADMIN_PASSWORD=Admin@123

# Supabase (backend service role key + storage buckets)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PRODUCTS_BUCKET=products
SUPABASE_CONTENT_BUCKET=content

# Node environment
NODE_ENV=development

# CORS Origin (set this to your frontend URL in production)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
